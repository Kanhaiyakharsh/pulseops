# PulseOps environment. Copy to `.env` (npm run setup does this for you).
# This single root file is read by the backend, the frontend (Vite) and Docker Compose.

# ── Backend ─────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug
APP_VERSION=0.1.0
SHUTDOWN_TIMEOUT_MS=10000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ── MongoDB (container settings + connection string; keep them in sync) ──
MONGO_ROOT_USERNAME=pulseops
MONGO_ROOT_PASSWORD=pulseops_dev_password
MONGO_DB_NAME=pulseops
MONGO_PORT=27017
MONGODB_URI=mongodb://pulseops:pulseops_dev_password@localhost:27017/pulseops?authSource=admin

# ── Redis (container settings + connection string; keep them in sync) ──
REDIS_PASSWORD=pulseops_dev_password
REDIS_PORT=6379
REDIS_URL=redis://:pulseops_dev_password@localhost:6379

# ── Frontend (only VITE_* variables are exposed to the browser) ─────────
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server proxies /api requests to
API_PROXY_TARGET=http://localhost:4000
